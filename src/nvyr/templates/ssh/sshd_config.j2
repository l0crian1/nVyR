LogLevel {{ log_level | default("INFO") }}
# Generated by nVyR. Authentication uses the system's accounts and authorized_keys.
Port 22
AddressFamily any

{%- if configuration.get('listen-address') %}
    {%- for address in configuration['listen-address'] | sort %}
ListenAddress {{ ip_address(address) }}
    {%- endfor %}
{%- else %}
ListenAddress 0.0.0.0
ListenAddress ::
{%- endif %}
HostKey {{ json_text(host_key) | trim }}
PidFile none
UsePAM yes
PermitRootLogin prohibit-password
PermitEmptyPasswords no
KbdInteractiveAuthentication no
PasswordAuthentication yes
AllowGroups nvyr-access
PermitUserEnvironment no
PermitUserRC no
Subsystem sftp internal-sftp
Match Group nvyr-sys-admin,nvyr-net-admin,nvyr-read-only
    ForceCommand /usr/bin/nvyr-login
    DisableForwarding yes
