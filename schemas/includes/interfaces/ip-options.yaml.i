# Generated by build_tools/kernel_settings.py; edit kernel_settings_map.py.

children:


  ip:
    kind: node
    anchor: true
    description: IPv4 settings for this interface
    children:


      receive-redirects:
        kind: leaf_node
        description: Accept ICMP redirects; inherits firewall global setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      send-redirects:
        kind: leaf_node
        description: Send ICMP redirects; inherits firewall global setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      source-route:
        kind: leaf_node
        description: Accept IPv4 source-route options; inherits firewall global setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      directed-broadcast:
        kind: leaf_node
        description: Forward IPv4 directed broadcasts; inherits firewall global setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      log-martians:
        kind: leaf_node
        description: Log packets with invalid addresses; inherits firewall global setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      arp-cache-timeout:
        kind: leaf_node
        description: Base ARP reachable time; actual reachable time is randomized; inherits firewall global setting
        validators:
          kernel-duration:
            milliseconds: true
            minimum: 1
            maximum: 2147483647
        hints:
          duration: Duration in ms, s, m, h or d; default 30s

      arp-filter:
        kind: leaf_node
        description: Use routing decisions when answering ARP requests; inherits firewall global setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      arp-announce:
        kind: leaf_node
        description: Select source addresses for outgoing ARP requests; inherits firewall global setting
        choices:
          any: Allow any local source address (mode 0)
          subnet: Prefer a source in the destination subnet (mode 1)
          best-local: Use the best local address for the target (mode 2)
        validators:
          list:
            values: any subnet best-local

      arp-ignore:
        kind: leaf_node
        description: Restrict responses to incoming ARP requests; inherits firewall global setting
        choices:
          '0': Reply for any local target address, even on another interface
          '1': Reply only if the target address belongs to the receiving interface
          '2': Require a target on the receiving interface and a sender in that subnet
          '3': Do not reply for host-scope addresses; allow global and link scope
          '8': Never reply to ARP requests for local addresses
        validators:
          list:
            values: 0 1 2 3 8

      arp-accept:
        kind: leaf_node
        description: Create new neighbor entries from gratuitous ARP; inherits firewall global setting
        choices:
          disable: Disable this behavior
          enable: Enable this behavior
          same-subnet: Accept new gratuitous ARP entries only from the same subnet
        validators:
          list:
            values: disable enable same-subnet

      arp-notify:
        kind: leaf_node
        description: Send gratuitous ARP when a device comes up or changes MAC; inherits firewall global setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      arp-proxy:
        kind: leaf_node
        description: Answer ARP requests on behalf of routed destinations; inherits firewall global setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      arp-proxy-pvlan:
        kind: leaf_node
        description: Proxy ARP back through the receiving interface for private VLANs; inherits firewall global
          setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      disable-forwarding:
        kind: leaf_node
        description: Disable IPv4 forwarding on this interface
        valueless: true

      accept-local:
        kind: leaf_node
        description: Accept incoming packets with a local IPv4 source address
        valueless: true

      route-localnet:
        kind: leaf_node
        description: Allow routing 127.0.0.0/8 through this interface
        valueless: true

      promote-secondaries:
        kind: leaf_node
        description: Retain secondary IPv4 addresses when their primary is removed
        valueless: true

      arp-retransmit-interval:
        kind: leaf_node
        description: Interval between ARP probes
        validators:
          kernel-duration:
            milliseconds: true
            minimum: 1
            maximum: 2147483647
        hints:
          duration: Duration in ms, s, m, h or d; default 1s

      arp-stale-time:
        kind: leaf_node
        description: Interval for checking stale ARP neighbors
        validators:
          kernel-duration:
            milliseconds: false
            minimum: 1
            maximum: 2147483
        hints:
          duration: Duration in s, m, h or d; default 60s

  ipv6:
    kind: node
    anchor: true
    description: IPv6 kernel settings
    children:


      receive-redirects:
        kind: leaf_node
        description: Accept IPv6 redirects; inherits firewall global setting
        choices:
          enable: Enable this behavior
          disable: Disable this behavior
        validators:
          list:
            values: enable disable

      source-route:
        kind: leaf_node
        description: Accept only routing header type 2, or reject routing headers; inherits firewall global setting
        choices:
          disable: Disable this behavior
          routing-header-2: Accept only IPv6 routing header type 2
        validators:
          list:
            values: disable routing-header-2

      disable:
        kind: leaf_node
        description: Disable IPv6 and remove its addresses and routes
        valueless: true

      proxy-ndp:
        kind: leaf_node
        description: Enable proxy neighbor discovery; proxy entries are still required
        valueless: true

      hop-limit:
        kind: leaf_node
        description: Default IPv6 hop limit
        validators:
          integer-range:
            minimum: 1
            maximum: 255
        hints:
          number: 1–255; default 64

      autoconf:
        kind: leaf_node
        description: Acquire SLAAC addresses and accept router advertisements while routing
        valueless: true

      accept-router-advertisements:
        kind: leaf_node
        description: Accept router advertisements while routing, without enabling SLAAC
        valueless: true

      no-default-route:
        kind: leaf_node
        description: Do not learn a default route from router advertisements
        valueless: true

      no-ra-mtu:
        kind: leaf_node
        description: Ignore MTU advertised by IPv6 routers
        valueless: true

      address-generation:
        kind: leaf_node
        description: Algorithm for automatically generated IPv6 addresses
        choices:
          eui64: Generate addresses from the interface MAC using modified EUI-64
          stable-privacy: Generate stable addresses with a persistent private secret
        validators:
          list:
            values: eui64 stable-privacy

      temporary-addresses:
        kind: leaf_node
        description: Generate temporary SLAAC addresses and select source-address preference
        choices:
          disable: Disable this behavior
          prefer-public: Generate temporary addresses but prefer public source addresses
          prefer-temporary: Generate and prefer temporary source addresses
        validators:
          list:
            values: disable prefer-public prefer-temporary

      maximum-autoconf-addresses:
        kind: leaf_node
        description: Maximum automatically configured IPv6 addresses
        validators:
          integer-range:
            minimum: 1
            maximum: 65535
        hints:
          number: 1–65535; default 16

      duplicate-address-detection:
        kind: node
        anchor: true
        description: IPv6 duplicate address detection
        children:


          disable:
            kind: leaf_node
            description: Disable IPv6 duplicate address detection
            valueless: true

          probes:
            kind: leaf_node
            description: Neighbor solicitations sent during duplicate address detection
            validators:
              integer-range:
                minimum: 1
                maximum: 100
            hints:
              number: 1–100; default 1

      neighbor-reachable-time:
        kind: leaf_node
        description: Base IPv6 neighbor reachable time; actual time is randomized
        validators:
          kernel-duration:
            milliseconds: true
            minimum: 1
            maximum: 2147483647
        hints:
          duration: Duration in ms, s, m, h or d; default 30s

      neighbor-retransmit-interval:
        kind: leaf_node
        description: Interval between IPv6 neighbor solicitations
        validators:
          kernel-duration:
            milliseconds: true
            minimum: 1
            maximum: 2147483647
        hints:
          duration: Duration in ms, s, m, h or d; default 1s

      neighbor-stale-time:
        kind: leaf_node
        description: Interval for checking stale IPv6 neighbors
        validators:
          kernel-duration:
            milliseconds: false
            minimum: 1
            maximum: 2147483
        hints:
          duration: Duration in s, m, h or d; default 60s

      eui64:
        kind: leaf_node
        description: Configure an IPv6 address derived from a /64 prefix and this interface MAC
        hints:
          address: IPv6 /64 network without host bits
        validators:

          interface-ipv6-value:
            kind: eui64
        multi: true

      interface-identifier:
        kind: leaf_node
        description: Fixed lower 64 bits for SLAAC addresses; requires autoconf
        hints:
          address: Nonzero IPv6 interface identifier, for example ::1234
        validators:

          interface-ipv6-value:
            kind: interface-identifier

      link-local-address:
        kind: leaf_node
        description: Use this IPv6 link-local address instead of an automatically generated one
        hints:
          address: IPv6 link-local address without a prefix, for example fe80::1
        validators:

          interface-ipv6-value:
            kind: link-local-address

      no-default-link-local:
        kind: leaf_node
        valueless: true
        description: Suppress automatically generated IPv6 link-local addresses
