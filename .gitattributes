# Generated JSON is byte-for-byte reproducible on Windows and Linux.
src/nvyr/schemas/*.json text eol=lf

# Linux deployment files must be executable from Windows-mounted workspaces.
*.sh text eol=lf
*.chroot text eol=lf
*.service text eol=lf
*.timer text eol=lf
images/packages.lock text eol=lf
images/container-sources.lock text eol=lf
# Installed Linux configuration files must also survive fresh Windows checkouts.
packaging/** text eol=lf
src/nvyr/op_scripts/*.py text eol=lf
# Unified-diff context prefixes are not source indentation or trailing whitespace.
vendor/frr/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
images/bootloaders/**/*.cfg text eol=lf
