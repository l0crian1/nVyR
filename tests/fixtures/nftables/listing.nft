add table inet nvyr_filter
add chain inet nvyr_filter ipv4_forward
add chain inet nvyr_filter ipv4_name_TARGET
add set inet nvyr_filter ipv4_address_group_LEARNED { type ipv4_addr; flags dynamic,timeout; timeout 10m; gc-interval 30s; size 65535; counter; last; elements = { 192.0.2.1 comment "seed|test" }; }
add set inet nvyr_filter port_group_WEB { type inet_service; flags interval; elements = { 80, 443, 8000-8010 }; }
add set inet nvyr_filter ipv4_match_group_PAIR { type ipv4_addr . inet_service; counter; last; elements = { 192.0.2.1 . 443 comment "first|entry" }; }
add map inet nvyr_filter ipv4_map_POLICY { type ipv4_addr . inet_service : verdict; counter; last; comment "Policy"; elements = { 192.0.2.1 . 443 comment "one|entry" : jump ipv4_name_TARGET }; }
add map inet nvyr_filter ipv4_map_NAT { type ipv4_addr . inet_service : ipv4_addr . inet_service; elements = { 203.0.113.1 . 443 comment "web|HTTPS" : 10.0.0.1 . 8443 }; }
add rule inet nvyr_filter ipv4_forward ct state { established, related } ct status == { 0x4008, snat | dnat } meta pkttype host iifname { "eth0", "eth1" } oifname "eth2" counter last accept comment "10|states"
add rule inet nvyr_filter ipv4_forward ether saddr & ff:ff:ff:00:00:00 == 11:22:33:00:00:00 ip saddr & 255.255.255.0 == 192.0.2.0 ip daddr { 10.0.0.0/24, 203.0.113.1 } meta mark { 1, 10-20 } ct mark 3 ip dscp 10 ip ttl > 10 ip ttl < 100 counter drop comment "20|masks"
add rule inet nvyr_filter ipv4_forward meta l4proto tcp th sport 1234 th dport { 80, 443 } tcp option maxseg size 1460 log prefix "test" counter last jump ipv4_name_TARGET comment "30|ports"
add rule inet nvyr_filter ipv4_forward meta l4proto icmp icmp type { echo-request, destination-unreachable } icmp code 0 reject comment "40|icmp"
add rule inet nvyr_filter ipv4_forward meta l4proto ipv6-icmp icmpv6 type nd-neighbor-solicit icmpv6 code 0 ip6 hoplimit 255 ip6 saddr 2001:db8::/32 return comment "50|ipv6"
add rule inet nvyr_filter ipv4_forward ip saddr @ipv4_address_group_LEARNED tcp dport @port_group_WEB counter accept comment "60|references"
add rule inet nvyr_filter ipv4_forward ip saddr . tcp dport @ipv4_match_group_PAIR counter accept comment "70|match group"
add rule inet nvyr_filter ipv4_forward ip saddr . tcp dport vmap @ipv4_map_POLICY comment "80|map"
add rule inet nvyr_filter ipv4_forward update @ipv4_address_group_LEARNED { ip saddr timeout 5m } continue comment "90|update"
add rule inet nvyr_filter ipv4_forward ct state vmap { established counter : accept, invalid counter : drop }
add rule inet nvyr_filter ipv4_forward meta nfproto vmap { ipv4 : jump ipv4_name_TARGET }
add rule inet nvyr_filter ipv4_forward ip saddr & 255.0.255.0 == 192.0.2.0 continue comment "94|mask4"
add rule inet nvyr_filter ipv4_forward ip6 daddr & ffff:0:ffff:: == 2001:0:db8:: counter last used 2s continue comment "95|noncontiguous"
add rule inet nvyr_filter ipv4_forward notrack continue comment "96|notrack"
add rule inet nvyr_filter ipv4_forward ct status == 0x6008 continue comment "97|helper"
add chain inet nvyr_filter ipv4_nat_prerouting
add rule inet nvyr_filter ipv4_nat_prerouting meta l4proto tcp dnat ip to ip daddr . tcp dport map @ipv4_map_NAT comment "1|map NAT"
add rule inet nvyr_filter ipv4_nat_prerouting meta l4proto udp dnat ip to 10.0.0.1-10.0.0.10:1000-2000 persistent,random comment "2|range NAT"
add rule inet nvyr_filter ipv4_nat_prerouting masquerade fully-random comment "3|masq"
add rule inet nvyr_filter ipv4_nat_prerouting snat ip to 198.51.100.1 persistent comment "5|source"
add rule inet nvyr_filter ipv4_nat_prerouting meta l4proto tcp dnat to : 8080 comment "6|port"
add rule inet nvyr_filter ipv4_nat_prerouting return comment "4|exclude"
