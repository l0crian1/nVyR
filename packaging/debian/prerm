#!/bin/sh
set -eu

if [ "$1" = remove ] && command -v systemctl >/dev/null && [ -d /run/systemd/system ]; then
    systemctl stop nvyr-session-reap.timer nvyr-session-reap.service || true
    systemctl stop nvyr-session-images.service nvyr-developer-access.service || true
    systemctl stop nvyr-geoip-update.timer nvyr-geoip-update.service || true
    systemctl stop nvyr-dhcp-hosts.timer nvyr-dhcp-hosts.service || true
    systemctl stop nvyr-configd.service || true
    systemctl stop nvyr-netlinkd.service || true
    systemctl stop 'nvyr-dhcp4@*.service' || true
    systemctl stop 'nvyr-ssh@*.service' || true
    systemctl stop nvyr-ntp.service || true
    systemctl stop nvyr-interface-naming.service || true
fi
