[Unit]
Description=nVyR DHCPv4 protocol client on %I
After=nvyr-interface-naming.service

[Service]
Type=simple
ExecStart=/usr/bin/nvyr-dhcp4 %I
Restart=always
RestartSec=3
KillSignal=SIGTERM
# udhcpc invokes the deconfig hook when releasing its lease.
KillMode=mixed
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/nvyr-netlink
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_PACKET
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
