set firewall ipv6 forward filter rule 50000 source-address 2001:db8:60::/48 action continue limit rate packets 100/s per source-address timeout 1m size 1024
set firewall ipv6 forward filter rule 50010 source-address 2001:db8:60::/48 action continue quota bytes 1m until
set firewall ipv6 output filter default-action accept
set firewall ipv6 prerouting raw rule 50000 protocol udp destination-port 56000 notrack action continue
set firewall ipv6 output raw rule 50000 protocol udp destination-port 56000 notrack action continue

set firewall ipv4 name OPSPASS default-action accept
set firewall ipv6 name OPSPASS default-action accept
set firewall zone OPSLAN interface eth1 default-action accept
set firewall zone OPSWAN interface eth2 default-action accept
set firewall zone OPSLOCAL local-zone
set firewall zone-policy from-zone OPSLAN to-zone OPSWAN ipv4-policy OPSPASS ipv6-policy OPSPASS
set firewall zone-policy from-zone OPSWAN to-zone OPSLAN ipv4-policy OPSPASS ipv6-policy OPSPASS
set firewall zone-policy from-zone OPSLAN to-zone OPSLOCAL ipv4-policy OPSPASS ipv6-policy OPSPASS
set firewall zone-policy from-zone OPSLOCAL to-zone OPSLAN ipv4-policy OPSPASS ipv6-policy OPSPASS

set nat destination rule 50000 inbound-interface veth60 protocol tcp destination-address 10.60.10.1 destination-port 8080 translation address 10.60.40.10 translation port 8080
set nat source rule 50000 outbound-interface pd-OPSNET source-address 10.60.0.0/16 destination-address 10.60.40.10 translation address masquerade

set firewall fail-safe ipv4 input filter default-action drop
set firewall fail-safe ipv4 input filter rule 10 inbound-interface lo action accept
set firewall fail-safe ipv4 input filter rule 20 protocol tcp destination-port 22 action accept
set firewall fail-safe ipv4 input filter rule 30 protocol udp source-port 67 destination-port 68 action accept
set firewall fail-safe ipv6 input filter default-action drop
set firewall fail-safe ipv6 input filter rule 10 inbound-interface lo action accept
set firewall fail-safe ipv6 input filter rule 20 protocol tcp destination-port 22 action accept
set firewall fail-safe ipv6 input filter rule 30 protocol ipv6-icmp action accept
