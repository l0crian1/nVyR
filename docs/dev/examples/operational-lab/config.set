set firewall ipv6 input filter rule 50010 source-address 2001:db8:60::/48 action continue quota bytes 1m until
set firewall ipv6 input filter rule 50020 source-address 2001:db8:60::/48 action continue quota group OPSQUOTA counter group OPSCOUNT
set firewall ipv6 input filter rule 50030 source-address 2001:db8:60::/48 action continue add-to-group source-address OPSLEARN
set firewall ipv6 input filter rule 50040 source-address 2001:db8:60::/48 protocol udp action continue add-to-group match-group OPSDYNAMIC
set firewall ipv6 input filter rule 50050 map OPSMAP
set firewall ipv6 input filter rule 50060 protocol ipv6-icmp icmp-group OPSPING action continue
set firewall ipv6 input filter rule 50070 source-address 2001:db8:60::/48 action continue limit group OPSPER
