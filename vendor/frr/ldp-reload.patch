+
+/* Restore process inheritance without retaining an explicit interface disable. */
+DEFPY (default_mpls_ldp_sync,
+       default_mpls_ldp_sync_cmd,
+       "default ip ospf mpls ldp-sync",
+       "Restore default configuration\n"
+       IP_STR
+       "OSPF interface commands\n"
+       MPLS_STR
+       MPLS_LDP_SYNC_STR)
+{
+	VTY_DECLVAR_CONTEXT(interface, ifp);
+	struct ospf_if_params *params = IF_DEF_PARAMS(ifp);
+	struct ldp_sync_info *info = params->ldp_sync_info;
+	struct ospf *ospf;
+
+	if (info == NULL)
+		return CMD_SUCCESS;
+
+	UNSET_FLAG(info->flags, LDP_SYNC_FLAG_IF_CONFIG);
+	info->enabled = LDP_IGP_SYNC_DEFAULT;
+	info->state = LDP_IGP_SYNC_STATE_NOT_REQUIRED;
+	event_cancel(&info->t_holddown);
+	ospf = ospf_lookup_by_vrf_id(ifp->vrf->vrf_id);
+	if (ospf && CHECK_FLAG(ospf->ldp_sync_cmd.flags, LDP_SYNC_FLAG_ENABLE))
+		ospf_if_set_ldp_sync_enable(ospf, ifp);
+	ospf_if_recalculate_output_cost(ifp);
 	return CMD_SUCCESS;
 }
 
