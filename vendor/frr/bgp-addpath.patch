+/* Update the configured receive limit and notify actual neighbors, not the
+ * peer-group template. A withdrawn capability clears a previous limit too.
+ */
+static void peer_paths_limit_update(struct peer *peer, afi_t afi, safi_t safi,
+                                   uint16_t limit)
+{
+	peer->addpath_paths_limit[afi][safi].send = limit;
+	if (!CHECK_FLAG(peer->sflags, PEER_STATUS_GROUP)) {
+		bgp_capability_send(peer->connection, afi, safi,
+				    CAPABILITY_CODE_PATHS_LIMIT,
+				    CAPABILITY_ACTION_UNSET);
+		bgp_capability_send(peer->connection, afi, safi,
+				    CAPABILITY_CODE_PATHS_LIMIT,
+				    CAPABILITY_ACTION_SET);
+	}
+}
+
+static void peer_group_paths_limit_update(struct peer *peer, afi_t afi,
+                                         safi_t safi, uint16_t limit)
+{
+	struct peer *member;
+	struct listnode *node;
+
+	peer_paths_limit_update(peer, afi, safi, limit);
+	if (!CHECK_FLAG(peer->sflags, PEER_STATUS_GROUP))
+		return;
+	for (ALL_LIST_ELEMENTS_RO(peer->group->peer, node, member)) {
+		if (!CHECK_FLAG(member->af_flags_override[afi][safi],
+				PEER_FLAG_ADDPATH_RX_PATHS_LIMIT))
+			peer_paths_limit_update(member, afi, safi, limit);
+	}
+}
