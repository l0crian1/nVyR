# Persist kernel MPLS membership and both LDP families across the acceptance reboot.
# The opposite end is a VRF, so adjacency/label forwarding belongs to the routed
# functional scenario. Finite IGP hold-downs allow this transit to remain usable.
set protocols mpls interface veth997
set protocols mpls fec nexthop-resolution default-ttl 96
set protocols mpls lsp 16011 next-hop 198.18.195.2 outgoing-label implicit-null
set protocols static route 198.19.245.1/32 next-hop 198.18.195.2 label 18000/18001
set protocols static route6 2001:db8:245::1/128 next-hop 2001:db8:195::2 label 18000/18002
set protocols ldp options router-id 198.18.192.2 wait-for-sync 20
set protocols ldp options dual-stack transport-preference ipv4
set protocols ldp discovery hello interval 2 holdtime 10
set protocols ldp address-family ipv4 transport-address 198.18.192.2 interface veth997
set protocols ldp address-family ipv6 transport-address 2001:db8:192::2 interface veth997
set protocols ldp address-family ipv4 label local allocate host-routes
set protocols ldp address-family ipv6 label local advertise explicit-null
set protocols ospf ldp-sync hold-down 2
set protocols ospf interface veth997 ldp-sync hold-down 1
set protocols isis ldp-sync hold-down 2
set protocols isis interface veth997 ldp-sync hold-down 1

# LU readback and inheritance survive reboot alongside the established unicast
# acceptance sessions. Labeled packet delivery uses the routed functional peer.
set protocols bgp parameters labeled-unicast explicit-null both
set protocols bgp peer-group BOOTLU remote-as 65199
set protocols bgp peer-group BOOTLU address-family ipv4-labeled-unicast next-hop-self force soft-reconfiguration inbound
set protocols bgp peer-group BOOTLU address-family ipv6-labeled-unicast next-hop-self force soft-reconfiguration inbound
set protocols bgp peer-group BOOTLU address-family ipv4-labeled-unicast addpath receive-limit 4
set protocols bgp peer-group BOOTLU address-family ipv6-labeled-unicast addpath receive-limit 4
set protocols bgp neighbor 198.18.192.3 peer-group BOOTLU shutdown
set protocols bgp address-family ipv4-labeled-unicast maximum-paths ebgp 4 ibgp 2
set protocols bgp address-family ipv6-labeled-unicast maximum-paths ebgp 4 ibgp 2 next-hop prefer-global
